{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KAIPlus user-facing capability projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups", "capabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/group"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "zh-CN": {"type": "string", "minLength": 1}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "kind", "title", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["product", "personal"]},
        "title": {"$ref": "#/$defs/localized"},
        "description": {"$ref": "#/$defs/localized"}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["primary", "support", "helper", "evidence", "router", "compatibility"]}
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ubuntu", "debian", "istoreos", "macos", "windows"]}
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{0,127}$"}
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group", "order", "title", "description", "ownership", "risk", "targets", "prompt", "modules"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "group": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/localized"},
        "description": {"$ref": "#/$defs/localized"},
        "ownership": {"enum": ["managed", "optional"]},
        "risk": {"enum": ["read-only", "confirmation", "high-risk"]},
        "targets": {"$ref": "#/$defs/targets"},
        "prompt": {"$ref": "#/$defs/localized"},
        "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}}
      }
    }
  }
}
